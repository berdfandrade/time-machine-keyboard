<?xml version="1.0" encoding="utf-8"?>
<!--
  Sem android.permission.INTERNET, de propósito: o teclado nunca envia texto para fora do aparelho.
  Sem AccessibilityService. Backup desligado para que nada saia do aparelho por esse caminho.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lista de apps instalados com ícone de launcher, usada só na tela "Apps excluídos". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TimeMachineApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeMachine">

        <activity
            android:name=".settings.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ime.TimeMachineIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
